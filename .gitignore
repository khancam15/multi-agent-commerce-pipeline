# Secrets
.env
.env.*
!.env.example
.env.bak*
.secrets.baseline

# Python environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Generated outputs (keep directory skeleton in git)
outputs/*
!outputs/.gitkeep
*.log

# Built storefront (deployed to its own branch/repo)
site/
site_preview/

# Loop logs (keep directory skeleton in git)
logs/*
!logs/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

# Local state
executor_state.json
history_list.txt

# Playwright browser session — contains live Etsy login, never commit
.playwright_profile/

# Scripts cache (never commit compiled bytecode)
scripts/__pycache__/
executor_state.json
history_list.txt
# Local database backups (copy off the server; never commit)
backups/

# Pause switch for the autonomous loop (./run.sh pause)
PAUSE
