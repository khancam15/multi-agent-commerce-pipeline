# Copy to .env and fill with your own credentials.
BRAND_NAME=Your Brand
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ── Stripe (payments) ─────────────────────────────────────────────────────────
# Stripe has no monthly fee; it takes a per-sale fee only.
# Run once (💻 HOST): python scripts/stripe_setup.py
# Start with a test key (sk_test_...) and pay with card 4242 4242 4242 4242.
# A restricted key (rk_...) with Products, Prices, Payment Links and
# Checkout Sessions write access is safer than the full secret key.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STORE_CURRENCY=usd
# STRIPE_API_VERSION=                    # optional pin; defaults to your account's version

# New products are saved as drafts (no payment link, not on the storefront)
# so you can review them first. Make a draft live with:
#   ./run.sh approve "Product Name"
# Set to active to publish without review (not recommended).
STORE_PUBLISH_STATUS=draft

# ── Storefront (free static site) ─────────────────────────────────────────────
# ./run.sh store-build writes the site to site/; store-deploy force-pushes it
# to STOREFRONT_GIT_BRANCH of STOREFRONT_GIT_REMOTE. Point GitHub Pages,
# Cloudflare Pages or Netlify at that branch.
STOREFRONT_BASE_URL=https://your-name.github.io/your-store
STOREFRONT_TAGLINE=Editable Canva templates for small businesses
# Use an SSH remote with a deploy key that can write only to this repo.
STOREFRONT_GIT_REMOTE=git@github.com:your-name/your-store.git
STOREFRONT_GIT_BRANCH=gh-pages

# Phase 5 refuses to publish a product that has no Canva template link,
# because buyers would have nothing to download. Leave this false.
ALLOW_PUBLISH_WITHOUT_TEMPLATE=false

# ── Canva Connect API credentials ─────────────────────────────────────────────
# Run once (💻 HOST): python scripts/canva_oauth.py
# That script opens your browser, completes OAuth, and fills these in for you.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# Canva MCP OAuth token — used by Phase 3 (canva_image_generator.py)
# Populated automatically after running canva_oauth.py.
# To set manually: visit the OAuth URL printed by canva_image_generator.py,
# authorise, copy the Bearer token, and paste here as: CANVA_MCP_TOKEN=Bearer <token>
CANVA_MCP_TOKEN=

# ── Publishing cadence ────────────────────────────────────────────────────────
# Max products published per calendar week (Mon–Sun UTC).
# Pipeline switches to maintain mode (SEO-only) once this is reached.
# Recommended: 3–7 for a new store, up to 20 for an established one.
WEEKLY_PUBLISH_LIMIT=5

# Minimum hours between consecutive publishes.
# Prevents burst-publishing — spreads listings naturally across the week.
# 24 = one listing per day (recommended). Set lower (e.g. 12) to publish faster.
PUBLISH_COOLDOWN_HOURS=24

# ── Models (optional overrides) ───────────────────────────────────────────────
# PHASE1_MODEL=claude-haiku-4-5     # brand strategy crew
# PHASE2_MODEL=claude-haiku-4-5     # listing content
# CANVA_MODEL=claude-opus-4-5       # Canva MCP design phases (3 and 3B)

# Disable CrewAI telemetry/tracing (keeps logs clean on VPS)
CREWAI_TRACING_ENABLED=false

# Daily email digest — design brief sent every morning
# Generate app password at: myaccount.google.com/apppasswords
# (requires Gmail 2FA to be enabled)
EMAIL_TO=your_email@gmail.com
EMAIL_FROM=your_gmail@gmail.com
EMAIL_SMTP_PASS=your_gmail_app_password

# ── Buyer delivery ────────────────────────────────────────────────────────────
# After payment, order_delivery.py emails each buyer their Canva template link
# from EMAIL_FROM. Stripe Checkout collects the buyer's email on every
# Payment Link, so nothing extra is needed in Stripe.
# SUPPORT_EMAIL=support@your-store.com   # shown to buyers; defaults to EMAIL_FROM
# DELIVERY_INTERVAL=600                  # seconds between delivery checks while idle
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── Alerts and backups ────────────────────────────────────────────────────────
# Alerts go to EMAIL_TO when a phase fails twice in a row.
# ALERT_REPEAT_HOURS=12
# BACKUP_KEEP_DAYS=14

# ── AI Ops Atlas (optional) ───────────────────────────────────────────────────
# Reports each loop phase result (label, ok/failed, time; no product or buyer
# data) so Atlas shows real runs. Leave blank to send nothing.
# ATLAS_FEED_URL=https://ai-ops-atlas.pages.dev/api/hooks/agents
# ATLAS_FEED_TOKEN=

# ── Least privilege (recommended) ─────────────────────────────────────────────
# true: run.sh and loop.sh give each script only the secrets it needs (for
# example the brand crew never holds the Stripe key or the Gmail password).
# Map in scripts/scoped_env.py; see docs/least-privilege.md.
AGENT_ENV_SCOPING=false

# ── Daily caps (runaway protection) ───────────────────────────────────────────
# Hard limits in code, on top of your provider dashboards. Reset at midnight UTC.
# MAX_MODEL_RUNS_PER_DAY=96   # model-driven script starts (brand, listings, Canva)
# MAX_EMAILS_PER_DAY=100      # buyer emails; past it they retry after the reset
# MAX_ALERTS_PER_DAY=20
